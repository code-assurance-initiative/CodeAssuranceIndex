[Unit]
Description=CAI — codeassuranceindex.info (the open standard: rubric API + UI + scorer)
Documentation=https://github.com/code-assurance-initiative/CodeAssuranceIndex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jimmy
Group=jimmy
WorkingDirectory=/home/jimmy/apps/cai-web/app
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:8090
Environment=HOME=/home/jimmy
Environment=Rubrics__Root=/home/jimmy/apps/cai-web/rubrics
# ★★ NO Syndication__* HERE, AND IT IS NOT AN OMISSION. This file is committed FOR REFERENCE — the deploy
#    never installs it (see the header of .github/workflows/deploy.yml), so anything added here reaches the
#    running service only if somebody edits the unit on the host by hand. A publisher configured in a file
#    nothing reads is a publisher that is silently inert, which is the one failure mode this whole move
#    cannot afford. The site, the site id and the discovered token are written by the deploy into
#    appsettings.Production.json inside the published app directory, which the host loads because
#    ASPNETCORE_ENVIRONMENT=Production is set above.
ExecStart=/usr/bin/dotnet /home/jimmy/apps/cai-web/app/Cai.Web.dll
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
